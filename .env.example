# ==============================================================================
# ApexStore - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env
# 2. Replace placeholder values with your environment-specific configuration.
# 3. NEVER commit the actual '.env' file containing real secrets to Git.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------------------------------------------
POSTGRES_USER=placeholder_db_user
POSTGRES_PASSWORD=placeholder_db_password
POSTGRES_DB=apexstore_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://placeholder_db_user:placeholder_db_password@postgres:5432/apexstore_db

# ------------------------------------------------------------------------------
# Redis In-Memory Cache Settings
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# Backend Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Provide a strong, cryptographically secure 256-bit key in production
SECRET_KEY=placeholder_jwt_secret_key_minimum_32_characters_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Service Ports & External URLs
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# CI/CD & Docker Registry Settings
# ------------------------------------------------------------------------------
DOCKERHUB_USERNAME=placeholder_dockerhub_username
BACKEND_IMAGE=placeholder_dockerhub_username/apexstore-backend:latest
FRONTEND_IMAGE=placeholder_dockerhub_username/apexstore-frontend:latest
